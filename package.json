{
  "name": "@gnu6/in",
  "version": "0.0.0-private",
  "private": true,
  "description": "Headless scenic, spatial, and topology runtime for gnu6 consumers.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "build:pixi-qualification": "vite build --config qualification/pixi/vite.config.ts",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@playwright/test": "1.63.0",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "pixi.js": "8.22.0"
  }
}
